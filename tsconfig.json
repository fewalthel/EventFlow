{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@widgets/*": [
        "widgets/*"
      ],
      "@utils/*": [
        "utils/*"
      ],
      "@pages/*": [
        "pages/*"
      ],
      "@shared/*": [
        "shared/*"
      ],
      "@entities/*": [
        "entities/*"
      ],
      "@app/*": ["app/*"]
    },
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "composite": true,  // Добавьте это
    "declaration": true,  // Добавьте это
    "outDir": "./dist",  // Укажите выходную директорию
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "src",
    "src/app/vite-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
